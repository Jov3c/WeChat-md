{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeChat MD",
  "version": "0.1.0",
  "identifier": "com.jov3.wechatmd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WeChat MD Editor",
        "width": 1600,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "backgroundColor": "#FAF9F5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
